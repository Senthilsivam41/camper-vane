# Camper Vane — environment template (placeholders only; never commit real secrets)
# Copy to `.env` (or export in your process manager / secret store) and fill in.
# Full ops notes: docs/ops.md
# Container path: docker compose up --build (reads this file via env_file; see docs/ops.md §4b).
# Local Compose HTTP (:80): set COOKIE_SECURE=false and FRONTEND_URL / OAUTH_REDIRECT_URI to http://localhost...

# --- Core / fail-loud production gates ---
# APP_ENV=production refuses default JWT_SECRET and defaults Secure cookies + mock providers OFF.
APP_ENV=production
JWT_SECRET=replace-with-long-random-secret
PORT=8080

# --- Session cookies ---
# Defaults when APP_ENV=production: COOKIE_SECURE=true, COOKIE_SAMESITE=lax
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Mock guards (explicit false recommended in prod even though defaults are safe) ---
ALLOW_MOCK_AUTH=false
ALLOW_MOCK_PROVIDERS=false

# --- Public URLs (do NOT leave localhost defaults in production) ---
FRONTEND_URL=https://camper.example.com
# Must EXACTLY match the redirect URI whitelisted in your IdP app settings:
OAUTH_REDIRECT_URI=https://camper.example.com/api/v1/auth/callback

# IdP redirect whitelist steps:
#   Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#     → Authorized redirect URIs → add the exact OAUTH_REDIRECT_URI value above
#   GitHub → Settings → Developer settings → OAuth Apps → Authorization callback URL
#     → set to the exact OAUTH_REDIRECT_URI value above
# Restart the API after changing IdP settings or these env vars.

# --- OAuth (set at least one provider pair for real login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Persistence ---
# Prefer PostgreSQL in production; omit DATABASE_URL to use SQLite at DATABASE_PATH.
DATABASE_URL=postgres://user:pass@db:5432/camper_vane?sslmode=require
# DATABASE_PATH=camper_vane.db

# --- CORS (only if SPA and API are on different origins; empty = same-origin / proxied /api) ---
# Exact origins only — never "*" (rejected at boot). Example:
# CORS_ALLOWED_ORIGINS=https://app.example.com
# For cross-origin cookies also set: COOKIE_SAMESITE=none (forces Secure)

# --- Provider API keys (server-held only; required for models you expose) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
