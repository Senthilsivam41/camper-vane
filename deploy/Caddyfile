# Same-origin reverse proxy for Camper Vane (recommended production layout).
# UI static files + /api → Go on :8080 so session cookies stay first-party.

camper.example.com {
	encode gzip

	handle /api/* {
		reverse_proxy localhost:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /var/www/camper-vane
		try_files {path} /index.html
		file_server
	}
}
